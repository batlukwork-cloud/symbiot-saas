APP_ENV=local
APP_NAME=Symbiot Runtime MVP
DATABASE_URL=postgresql://symbiot:symbiot@localhost:5432/symbiot_runtime
REDIS_URL=redis://localhost:6379/0
LLM_PROVIDER_MODE=mock
EXTERNAL_LLM_ALLOWED=false
AUDIT_REDACTION_ENABLED=true
TENANT_ISOLATION_REQUIRED=true
SYMBIOT_DEMO_SESSION_TOKEN=symbiot-demo-session-token
SYMBIOT_DEMO_TENANT_ID=tenant:demo
SYMBIOT_DEMO_ROLE=runtime-operator
SYMBIOT_DEMO_DEPARTMENT=sales
SYMBIOT_DEMO_ACCESS_LEVEL=standard
SYMBIOT_IDENTITY_PROVIDER_MODE=demo_headers
SYMBIOT_OIDC_PROVIDER=keycloak
SYMBIOT_KEYCLOAK_REALM=symbiot
SYMBIOT_OIDC_ISSUER=
SYMBIOT_OIDC_CLIENT_ID=
SYMBIOT_OIDC_JWKS_URL=
SYMBIOT_OIDC_JWKS_JSON=
SYMBIOT_OIDC_AUDIENCE=
# Production Keycloak deployment template:
# copy config/keycloak/production.env.example to a secrets-managed production env file.
SYMBIOT_OCR_PYTHON=python
SYMBIOT_EMBEDDING_BASE_URL=
SYMBIOT_EMBEDDING_API_KEY=
SYMBIOT_EMBEDDING_MODEL=symbiot-embedding-abstraction-v0.2
